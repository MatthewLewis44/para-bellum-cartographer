{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.venv/**/*)",
      "Read(./**/__pycache__/**/*)",
      "Read(./**/*.pyc)",
      "Read(./**/*.tif)",
      "Read(./**/*.tiff)",
      "Read(./**/*.gpkg)",
      "Read(./output/*_hex_terrain.json)",
      "Read(./output/*.html)",
      "Read(./data/boundaries/**/*)",
      "Read(./*.egg-info/**/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/Matthew/para-bellum-cartographer/para-bellum-cartographer/tools/hooks/guard-git.py\""
          }
        ]
      }
    ]
  }
}
