{
  "format": "pb-content/grammar-cases/1",
  "_comment": "Hostile and control cases for the research prerequisite grammar, shared by the pipeline's reference parser and the game's C# reader. A case with `refuse` must be refused with EXACTLY that one code: G1xx by parse(), G2xx by resolve() against `registry` (with `nation` as the owning row's nation). A case with `accept` must parse AND resolve cleanly, and `accept` is the parse written as clauses of alternatives, each alternative [kind, value]. `render` where present is the canonical spelling the parse must render back to. Cell null is a missing cell. EVERY NAME AND ID HERE IS SYNTHETIC: the cases prove the grammar, and a name only needs the SHAPE of a real one (a slash, a parenthesised comma, a diacritic, an id-shaped design name) to prove it.",
  "registry": {
    "ids": ["AA-01", "AA-03", "BB-09", "CC-07", "CC-10", "DD-04", "QQ-10", "EE-01", "EE-07"],
    "designs": ["Lancer Mk I (prototype B)", "ZX-3", "Kestrel 12(t)"],
    "flags": ["test_capture", "test_shortage", "test_covert", "test_seizure"],
    "fielded": ["test_heavy"],
    "focus": ["test_plan"],
    "xp": [["land", 1], ["land", 2], ["land", 3], ["air", 1], ["naval", 1]],
    "bureaus": {
      "Northland": ["Ostwerk-Hall", "Brennan", "Arsenal 6 (War Office, state)", "Kessel"],
      "Southland": ["Foo / Bar", "Varenne", "Atelier (state, from 1936)"],
      "Westland": ["Baz Works (Qux, state)"],
      "Eastland": ["Žurek Works", "ŘZ (Mala)"]
    },
    "vendors": ["Testvendor AB", "Oakfield-Marsh"],
    "nations": ["Northland", "Southland", "Westland", "Eastland", "Upland", "Lowland", "Midland"]
  },
  "cases": [
    { "id": "a01_empty_cell", "context": "gate", "cell": "", "accept": [],
      "note": "An empty cell is no prerequisite: the empty expression, which always holds." },
    { "id": "a02_missing_cell", "context": "gate", "cell": null, "accept": [] },
    { "id": "a03_cnf", "context": "gate", "cell": "DD-04, CC-07 | CC-10",
      "accept": [[["id", "DD-04"]], [["id", "CC-07"], ["id", "CC-10"]]], "render": "DD-04, CC-07 | CC-10",
      "note": "Pipe binds tighter than comma: DD-04 AND (CC-07 OR CC-10)." },
    { "id": "a04_slash_name_in_alternative", "context": "gate", "cell": "BB-09, flag:test_capture | bureau:Foo / Bar",
      "accept": [[["id", "BB-09"]], [["flag", "test_capture"], ["bureau", "Foo / Bar"]]],
      "render": "BB-09, flag:test_capture | bureau:Foo / Bar" },
    { "id": "a05_comma_inside_parentheses_gate", "context": "gate", "cell": "licence:Baz Works (Qux, state), AA-01",
      "accept": [[["licence", "Baz Works (Qux, state)"]], [["id", "AA-01"]]],
      "render": "licence:Baz Works (Qux, state), AA-01",
      "note": "The comma inside the parentheses is part of the name. A naive split reads three clauses." },
    { "id": "a06_comma_inside_parentheses_acquisition", "context": "acquisition", "nation": "Northland",
      "cell": "Arsenal 6 (War Office, state) | Brennan",
      "accept": [[["name", "Arsenal 6 (War Office, state)"], ["name", "Brennan"]]],
      "render": "Arsenal 6 (War Office, state) | Brennan",
      "note": "One clause of two competing bids, not a joint design." },
    { "id": "a07_joint_and_competing", "context": "acquisition", "nation": "Northland", "cell": "Ostwerk-Hall, Brennan | Kessel",
      "accept": [[["name", "Ostwerk-Hall"]], [["name", "Brennan"], ["name", "Kessel"]]] },
    { "id": "a08_acquisitions", "context": "acquisition", "nation": "Northland",
      "cell": "import:Testvendor AB | licence:Žurek Works | seized:ŘZ (Mala) | captured:Southland",
      "accept": [[["import", "Testvendor AB"], ["licence", "Žurek Works"], ["seized", "ŘZ (Mala)"], ["captured", "Southland"]]] },
    { "id": "a09_design_name_shaped_like_an_id", "context": "gate", "cell": "design:ZX-3",
      "accept": [[["design", "ZX-3"]]],
      "note": "A design name can have exactly the shape of an id. Only the design: prefix makes it a design." },
    { "id": "a10_design_name_with_parentheses", "context": "gate", "cell": "design:Lancer Mk I (prototype B), design:Kestrel 12(t)",
      "accept": [[["design", "Lancer Mk I (prototype B)"]], [["design", "Kestrel 12(t)"]]] },
    { "id": "a11_opaque_id_prefix_disagrees_with_category", "context": "gate", "cell": "QQ-10",
      "accept": [[["id", "QQ-10"]]],
      "note": "An id whose prefix names no category, or the wrong one, is still an id. The parser never reads the prefix (AD-M37 section 4)." },
    { "id": "a12_every_gate_prefix", "context": "gate",
      "cell": "EE-01, flag:test_covert, fielded:test_heavy, xp:land:2, focus:test_plan, licence:Oakfield-Marsh, bureau:Varenne",
      "accept": [[["id", "EE-01"]], [["flag", "test_covert"]], [["fielded", "test_heavy"]], [["xp", "land:2"]],
                 [["focus", "test_plan"]], [["licence", "Oakfield-Marsh"]], [["bureau", "Varenne"]]] },
    { "id": "a13_loose_spacing_accepted", "context": "gate", "cell": "AA-01 ,AA-03|  CC-07",
      "accept": [[["id", "AA-01"]], [["id", "AA-03"], ["id", "CC-07"]]], "render": "AA-01, AA-03 | CC-07",
      "note": "Spacing around separators is not meaning; render gives the canonical form." },
    { "id": "a14_list", "context": "list", "nation": "Westland", "cell": "Baz Works (Qux, state)",
      "accept": [[["name", "Baz Works (Qux, state)"]]] },
    { "id": "a15_non_ascii_spaces_around_separators", "context": "gate", "cell": "AA-01 ,　AA-03 | CC-07",
      "accept": [[["id", "AA-01"]], [["id", "AA-03"], ["id", "CC-07"]]], "render": "AA-01, AA-03 | CC-07",
      "note": "U+00A0 (no-break space) and U+3000 (ideographic space) are whitespace, like U+0020: trimmed around separators. Pins the whitespace set rather than assuming it." },

    { "id": "h101_blank_cell", "context": "gate", "cell": "   ", "refuse": "G101" },
    { "id": "h101b_non_ascii_blank_cell", "context": "gate", "cell": " 　", "refuse": "G101",
      "note": "A cell of no-break and ideographic spaces is blank, not empty." },
